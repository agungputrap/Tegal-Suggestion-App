{
  "name": "jajan-jasa-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create jajan-jasa-db",
    "db:migrate:local": "wrangler d1 execute jajan-jasa-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute jajan-jasa-db --remote --file=./schema.sql",
    "kv:create": "wrangler kv:namespace create ACTIVE_CACHE",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.78.0"
  }
}
