{
  "name": "jajan-jasa-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create jajan-jasa-db",
    "db:migrate:local": "wrangler d1 migrations apply jajan-jasa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply jajan-jasa-db --remote",
    "db:seed:places": "node scripts/seed-places.mjs && wrangler d1 execute jajan-jasa-db --local --file=./seed-places.sql",
    "db:seed:places:remote": "node scripts/seed-places.mjs && wrangler d1 execute jajan-jasa-db --remote --file=./seed-places.sql",
    "kv:create": "wrangler kv:namespace create ACTIVE_CACHE",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20240925.0",
    "papaparse": "^5.7.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  },
  "type": "module"
}
